<%- include('partials/header') %><section class="page-intro left-intro"><span class="eyebrow">MAKE IT HAPPEN</span><h1>Request your <em>next adventure.</em></h1><p>Send a booking request. You can track its status from your dashboard.</p></section><section class="auth-layout booking-layout"><div class="auth-aside booking-aside"><span class="eyebrow">TRAVEL WITH CONFIDENCE</span><h2>Good journeys<br>begin with a plan.</h2><p>Your request is not confirmed until the assigned agent responds.</p></div><div class="auth-card"><h2>Booking details</h2><form class="form-stack" method="post" action="/bookings"><label>Destination<select name="destination_id" required><option value="">Choose destination</option><% destinations.forEach(d=>{ %><option value="<%= d.id %>" <%= selected&&selected.destination_id===d.id?'selected':'' %>><%= d.name %></option><% }) %></select></label><label>Package (optional)<select name="package_id"><option value="">Custom trip</option><% packages.forEach(p=>{ %><option value="<%= p.id %>" <%= selected&&selected.id===p.id?'selected':'' %>><%= p.title %> · ৳ <%= money(p.package_price_bdt) %></option><% }) %></select></label><div class="form-row"><label>Start date<input type="date" name="start_date" required min="<%= new Date().toISOString().slice(0,10) %>"></label><label>End date<input type="date" name="end_date" required min="<%= new Date().toISOString().slice(0,10) %>"></label></div><label>Travellers<input type="number" name="travelers" min="1" max="100" value="2" required></label><label>Message for the agent<textarea name="message" rows="3" placeholder="Tell us about your plans or preferences…"></textarea></label><button class="btn btn-primary btn-full">Send booking request →</button></form></div></section><%- include('partials/footer') %>
