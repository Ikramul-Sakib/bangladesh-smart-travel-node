<%- include('partials/header') %><section class="dashboard-head"><div><span class="eyebrow">YOUR TRAVEL SPACE</span><h1>Good to see you, <em><%= user.name.split(' ')[0] %>.</em></h1><p>Keep your plans moving and your next adventure in sight.</p></div><a class="btn btn-primary" href="/planner">+ Plan a trip</a></section><% if(stats.length){ %><div class="stats-grid"><% stats.forEach((s,i)=>{ %><div class="stat-card"><span class="stat-icon"><%= ['⌁','✧','♙','▣'][i%4] %></span><span><%= s[0] %></span><strong><%= s[1] %></strong></div><% }) %></div><% } %><% if(user.role==='admin'){ %><section class="section compact"><div class="section-head"><div><span class="eyebrow">SITE MANAGEMENT</span><h2>Manage your travel directory</h2></div></div><div class="admin-links"><% [['destinations','Destinations'],['attractions','Attractions'],['hotels','Hotels'],['packages','Tour packages'],['transports','Transport options'],['food-costs','Food costs'],['expenses','Additional expenses']].forEach(x=>{ %><a href="/admin/<%= x[0] %>"><span>✧</span><%= x[1] %><b>↗</b></a><% }) %></div></section><% }else{ %><section class="section compact"><div class="section-head"><div><span class="eyebrow">YOUR JOURNEY IN PROGRESS</span><h2>Recent trip plans</h2></div><a class="text-link" href="/trips/my-plans">All plans ↗</a></div><% if(plans.length){ %><div class="table-wrap"><table><thead><tr><th>Destination</th><th>Dates</th><th>Estimate</th><th>Status</th><th></th></tr></thead><tbody><% plans.forEach(p=>{ %><tr><td><b><%= p.destination_name %></b></td><td><%= p.departure_date||'—' %> – <%= p.return_date||'—' %></td><td>৳ <%= money(p.estimated_total_bdt) %></td><td><span class="status"><%= p.status %></span></td><td><a href="/trips/<%= p.id %>">View ↗</a></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-state"><h3>No saved trips just yet</h3><p>Start with a destination and build your first plan.</p><a class="btn btn-primary" href="/planner">Plan a trip →</a></div><% } %><div class="section-head booking-head"><div><span class="eyebrow">KEEP TRACK</span><h2>Recent bookings</h2></div><a class="text-link" href="/bookings">All bookings ↗</a></div><% if(bookings.length){ %><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Destination</th><th>Status</th><th></th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><b><%= b.reference_code %></b></td><td><%= b.destination_name %></td><td><span class="status"><%= b.status %></span></td><td><a href="/bookings/<%= b.id %>">Details ↗</a></td></tr><% }) %></tbody></table></div><% }else{ %><p class="muted">No booking requests yet. <a href="/bookings/create">Request a booking</a>.</p><% } %><% } %></section><%- include('partials/footer') %>
