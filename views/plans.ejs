<%- include('partials/header') %><section class="dashboard-head"><div><span class="eyebrow">YOUR IDEAS, KEPT SAFE</span><h1>My trip <em>plans.</em></h1><p>Your saved estimates, all in one place.</p></div><a class="btn btn-primary" href="/planner">+ New plan</a></section><section class="section compact"><% if(plans.length){ %><div class="table-wrap"><table><thead><tr><th>Trip</th><th>Dates</th><th>Travellers</th><th>Estimate</th><th>Status</th><th>Actions</th></tr></thead><tbody><% plans.forEach(p=>{ %><tr><td><b><%= p.title||p.destination_name %></b><small class="table-sub"><%= p.destination_name %></small></td><td><%= p.departure_date||'—' %><br><%= p.return_date||'' %></td><td><%= p.travelers_count %></td><td>৳ <%= money(p.estimated_total_bdt) %></td><td><span class="status"><%= p.status %></span></td><td><a href="/trips/<%= p.id %>">View</a> <form class="inline" method="post" action="/trips/<%= p.id %>?_method=DELETE" data-confirm="Delete this saved trip?"><button class="link-danger">Delete</button></form></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-state"><div class="placeholder-icon">⌁</div><h3>Your travel ideas live here</h3><p>Use the planner to calculate costs and save a trip for later.</p><a class="btn btn-primary" href="/planner">Build a trip plan →</a></div><% } %></section><%- include('partials/footer') %>
