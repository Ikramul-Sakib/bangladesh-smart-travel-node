<%- include('partials/header') %><section class="page-intro left-intro"><span class="eyebrow">YOUR BUSINESS</span><h1>Agency <em>profile.</em></h1><p>Keep your agency details up to date for your travel operations.</p></section><section class="auth-card profile-card"><form class="form-stack" method="post" action="/agent/profile"><label>Agency name<input name="agency_name" value="<%= profile&&profile.agency_name||'' %>"></label><label>Contact phone<input name="contact_phone" value="<%= profile&&profile.contact_phone||'' %>"></label><div class="form-row"><label>Years of experience<input type="number" min="0" name="years_experience" value="<%= profile&&profile.years_experience||0 %>"></label><label>Group capacity<input type="number" min="1" name="max_group_capacity" value="<%= profile&&profile.max_group_capacity||10 %>"></label></div><label>Service fee (BDT)<input type="number" min="0" name="service_fee_bdt" value="<%= profile&&profile.service_fee_bdt||0 %>"></label><label>About your agency<textarea name="bio" rows="5"><%= profile&&profile.bio||'' %></textarea></label><p class="form-note">Approval status: <b><%= profile&&profile.approval_status||'pending' %></b></p><button class="btn btn-primary">Save profile</button></form></section><%- include('partials/footer') %>
