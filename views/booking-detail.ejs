<%- include('partials/header') %><section class="page-intro left-intro"><span class="eyebrow">BOOKING REFERENCE · <%= b.reference_code %></span><h1><%= b.destination_name %></h1><p>Requested by <%= b.tourist_name %> · <%= b.travelers_count %> traveller(s)</p><span class="status status-<%= b.status %>"><%= b.status %></span></section><section class="detail-panel"><div class="cost-list"><div><span>Start date</span><b><%= b.start_date %></b></div><div><span>End date</span><b><%= b.end_date %></b></div><div><span>Quoted amount</span><b><%= b.quoted_amount_bdt?'৳ '+money(b.quoted_amount_bdt):'Awaiting quote' %></b></div><div><span>Status</span><b><%= b.status %></b></div></div><% if(b.tourist_message){ %><h3>Your message</h3><p><%= b.tourist_message %></p><% } %><% if(b.agent_response){ %><h3>Agent response</h3><p><%= b.agent_response %></p><% } %><% if(user.role==='agent'){ %><form class="form-stack" method="post" action="/bookings/<%= b.id %>/respond"><label>Response<select name="status"><option value="accepted">Accept</option><option value="rejected">Reject</option><option value="confirmed">Confirm</option><option value="completed">Mark completed</option><option value="cancelled">Cancel</option></select></label><label>Message<textarea name="response" rows="3"></textarea></label><button class="btn btn-primary">Submit response</button></form><% } %><a class="text-link" href="/bookings">← Back to bookings</a></section><%- include('partials/footer') %>
