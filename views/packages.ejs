<%- include('partials/header') %><section class="page-intro"><span class="eyebrow">A LITTLE LESS PLANNING, A LOT MORE EXPLORING</span><h1>Good trips, <em>thoughtfully planned.</em></h1><p>Browse available tours and find the right fit for your next getaway.</p></section><section class="section compact"><div class="package-grid"><% packages.forEach((p,i)=>{ %><article class="package-card package-large"><div class="package-icon"><%= ['✧','⌁','☼'][i%3] %></div><span class="pill"><%= p.duration_days %> days · <%= p.destination_name %></span><h3><%= p.title %></h3><p><%= (p.description||'A memorable trip with the essentials thoughtfully considered.').slice(0,150) %></p><div class="package-bottom"><strong>৳ <%= money(p.package_price_bdt) %></strong><a href="/packages/<%= p.id %>">Explore package ↗</a></div></article><% }) %><% if(!packages.length){ %><div class="empty-state"><h3>No packages available yet</h3><p>Try the trip planner to build your own estimate.</p><a class="btn btn-primary" href="/planner">Open trip planner</a></div><% } %></div></section><%- include('partials/footer') %>
