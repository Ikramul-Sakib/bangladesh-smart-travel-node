<%- include('partials/header') %><section class="dashboard-head"><div><span class="eyebrow">ADMINISTRATION</span><h1><%= config.label %></h1><p>Manage the records shown across the travel experience.</p></div><a class="btn btn-primary" href="/admin/<%= resource %>/new">+ Add record</a></section><section class="section compact"><% if(rows.length){ %><div class="table-wrap"><table><thead><tr><th>ID</th><% config.fields.forEach(f=>{ %><th><%= f[1] %></th><% }) %><th>Actions</th></tr></thead><tbody><% rows.forEach(row=>{ %><tr><td><%= row.id %></td><% config.fields.forEach(f=>{ %><td><%= row[f[0]]==null?'—':String(row[f[0]]).slice(0,90) %></td><% }) %><td class="actions"><a href="/admin/<%= resource %>/<%= row.id %>/edit">Edit</a><form method="post" action="/admin/<%= resource %>/<%= row.id %>?_method=DELETE" data-confirm="Delete this record?"><button class="link-danger">Delete</button></form></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-state"><h3>No records yet</h3><p>Add the first record to start populating this section.</p><a class="btn btn-primary" href="/admin/<%= resource %>/new">Add <%= config.label.toLowerCase() %></a></div><% } %><div class="admin-links admin-links-small"><% [['destinations','Destinations'],['attractions','Attractions'],['hotels','Hotels'],['packages','Tour packages'],['transports','Transport'],['food-costs','Food costs'],['expenses','Expenses']].filter(x=>x[0]!==resource).forEach(x=>{ %><a href="/admin/<%= x[0] %>"><%= x[1] %> <b>↗</b></a><% }) %></div></section><%- include('partials/footer') %>
