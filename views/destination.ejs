<%- include('partials/header') %><section class="detail-hero"><div class="detail-scene scene scene-2"><span class="scene-symbol">⌁</span></div><div class="detail-copy"><span class="eyebrow"><%= destination.division||'BANGLADESH' %><%= destination.district?' · '+destination.district:'' %></span><h1><%= destination.name %></h1><p><%= destination.description||'A wonderful place to experience the beauty and culture of Bangladesh.' %></p><a class="btn btn-primary" href="/planner">Plan a visit →</a></div></section><section class="section"><div class="section-head"><div><span class="eyebrow">MAKE IT YOURS</span><h2>Discover the details</h2></div><a class="text-link" href="/destinations">← All destinations</a></div><% if(attractions.length){ %><h3 class="subhead">Things to see</h3><div class="simple-grid"><% attractions.forEach(a=>{ %><a class="simple-card" href="/attractions/<%= a.id %>"><span class="mini-icon">✧</span><div><h3><%= a.name %></h3><p><%= a.category||'Attraction' %></p><small>Entrance fee: ৳ <%= money(a.entrance_fee_bdt) %></small></div><span>↗</span></a><% }) %></div><% } %><% if(hotels.length){ %><h3 class="subhead">Places to stay</h3><div class="simple-grid"><% hotels.forEach(h=>{ %><div class="simple-card"><span class="mini-icon">⌂</span><div><h3><%= h.name %></h3><p><%= h.category||h.address||'Accommodation' %></p><small>From ৳ <%= money(h.price_per_night_bdt) %> / night</small></div></div><% }) %></div><% } %><% if(packages.length){ %><h3 class="subhead">Packages here</h3><div class="package-grid"><% packages.forEach(p=>{ %><article class="package-card"><span class="pill"><%= p.duration_days %> days</span><h3><%= p.title %></h3><div class="package-bottom"><strong>৳ <%= money(p.package_price_bdt) %></strong><a href="/packages/<%= p.id %>">Details ↗</a></div></article><% }) %></div><% } %></section><%- include('partials/footer') %>
