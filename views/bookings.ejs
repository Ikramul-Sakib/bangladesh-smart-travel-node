<%- include('partials/header') %><section class="dashboard-head"><div><span class="eyebrow">BOOKING MANAGEMENT</span><h1>Booking <em>requests.</em></h1><p>Review requests and keep every detail in view.</p></div><% if(user.role==='tourist'){ %><a class="btn btn-primary" href="/bookings/create">+ New request</a><% } %></section><section class="section compact"><% if(bookings.length){ %><div class="table-wrap"><table><thead><tr><th>Reference</th><th>Traveller</th><th>Destination</th><th>Dates</th><th>Guests</th><th>Status</th><th></th></tr></thead><tbody><% bookings.forEach(b=>{ %><tr><td><b><%= b.reference_code %></b></td><td><%= b.tourist_name||user.name %></td><td><%= b.destination_name %></td><td><%= b.start_date %> – <%= b.end_date %></td><td><%= b.travelers_count %></td><td><span class="status status-<%= b.status %>"><%= b.status %></span></td><td><a href="/bookings/<%= b.id %>">Details ↗</a></td></tr><% }) %></tbody></table></div><% }else{ %><div class="empty-state"><h3>Nothing on the books yet</h3><p>When a booking request is made, you’ll see its details here.</p><% if(user.role==='tourist'){ %><a class="btn btn-primary" href="/bookings/create">Request a booking →</a><% } %></div><% } %></section><%- include('partials/footer') %>
