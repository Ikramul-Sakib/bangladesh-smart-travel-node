<%- include('partials/header') %><section class="page-intro"><span class="eyebrow">THE COUNTRY IS YOURS TO EXPLORE</span><h1>Find your kind of <em>somewhere.</em></h1><p>Explore destinations across Bangladesh, from quiet escapes to unforgettable landmarks.</p><div class="search-wrap"><span>⌕</span><input id="filter-cards" placeholder="Search destinations or districts…" aria-label="Search destinations"></div></section><section class="section compact"><div class="destination-grid" id="filter-grid"><% destinations.forEach((d,i)=>{ %><a class="destination-card filter-item" data-search="<%= (d.name+' '+(d.division||'')+' '+(d.district||'')).toLowerCase() %>" href="/destinations/<%= d.id %>"><div class="destination-image scene scene-<%= i%4 %>"><span class="scene-symbol"><%= ['⌁','☼','♧','◈'][i%4] %></span><span class="image-tag"><%= d.division||'Bangladesh' %></span></div><div class="destination-info"><div><h3><%= d.name %></h3><p><%= d.district||d.division||'Bangladesh' %></p></div><span class="round-arrow">↗</span></div><p class="card-desc"><%= (d.description||'A destination waiting to be discovered.').slice(0,120) %></p></a><% }) %><% if(!destinations.length){ %><div class="empty-state"><h3>No destinations published yet</h3><p>Check back soon for places to explore.</p></div><% } %></div></section><%- include('partials/footer') %>
