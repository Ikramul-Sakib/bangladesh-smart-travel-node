<%- include('partials/header') %><section class="page-intro left-intro"><span class="eyebrow">SAVED TRIP · <%= p.status.toUpperCase() %></span><h1><%= p.title||p.destination_name %></h1><p><%= p.departure_date %> to <%= p.return_date %> · <%= p.travelers_count %> traveller(s)</p><div class="price-large">৳ <%= money(p.estimated_total_bdt) %><small>estimated total</small></div><p>Budget: ৳ <%= money(p.budget_bdt) %> · <%= p.fits_budget?'Within budget':'Review your budget' %></p><a class="btn btn-primary" href="/bookings/create">Request a booking →</a> <form class="inline" method="post" action="/trips/<%= p.id %>?_method=DELETE" data-confirm="Delete this saved trip?"><button class="btn btn-outline">Delete plan</button></form></section><%- include('partials/footer') %>
