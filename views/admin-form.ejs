<%- include('partials/header') %><section class="page-intro left-intro"><span class="eyebrow">ADMINISTRATION · <%= config.label.toUpperCase() %></span><h1><%= title %></h1><p>Complete the fields below. Changes are saved to your local database.</p></section><section class="auth-card profile-card"><form class="form-stack" method="post" action="/admin/<%= resource %><%= item.id?'/'+item.id:'' %>"><% if(item.id){ %><input type="hidden" name="_method" value="PUT"><% } %><% config.fields.forEach(f=>{ %><label><%= f[1] %><% if(f[2]==='destination'){ %><select name="<%= f[0] %>" required><option value="">Choose destination</option><% destinations.forEach(d=>{ %><option value="<%= d.id %>" <%= String(item[f[0]]||'')===String(d.id)?'selected':'' %>><%= d.name %></option><% }) %></select><% }else if(f[2]==='textarea'){ %><textarea name="<%= f[0] %>" rows="4"><%= item[f[0]]||'' %></textarea><% }else{ %><input type="<%= f[2] %>" name="<%= f[0] %>" value="<%= item[f[0]]==null?'':item[f[0]] %>" <%= ['name','title'].includes(f[0])?'required':'' %> <%= f[2]==='number'?'min="0" step="0.01"':'' %>><% } %></label><% }) %><div class="form-row"><button class="btn btn-primary">Save record</button><a class="btn btn-outline" href="/admin/<%= resource %>">Cancel</a></div></form></section><%- include('partials/footer') %>
