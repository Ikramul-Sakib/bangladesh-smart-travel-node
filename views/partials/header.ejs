<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0c6b57"><title><%= title %> · Bangladesh Smart Travel</title><link rel="stylesheet" href="/css/style.css"></head><body><header class="site-header"><a class="brand" href="/"><span class="brand-mark">✦</span><span>Bangladesh<span class="brand-sub">SMART TRAVEL</span></span></a><button class="menu-toggle" aria-label="Toggle navigation" onclick="document.querySelector('.nav').classList.toggle('open')">☰</button><nav class="nav"><a href="/destinations">Destinations</a><a href="/packages">Packages</a><a href="/planner">Trip planner</a><% if(user){ %><a href="/dashboard">Dashboard</a><% if(user.role==='admin'){ %><a href="/admin/destinations">Admin</a><% } %><form class="inline" method="post" action="/logout"><button class="nav-button">Sign out</button></form><span class="user-chip"><%= user.name %></span><% }else{ %><a href="/login">Sign in</a><a class="nav-cta" href="/register">Get started</a><% } %></nav></header><main class="page-shell"><% if(flash){ %><div class="flash <%= flash.type==='error'?'flash-error':'' %>"><%= flash.message %><button onclick="this.parentElement.remove()" aria-label="Dismiss">×</button></div><% } %>
